# Copy this file to .env and set the values for your environment.
ARCHES_LOCAL_BASE_URL=
ARCHES_LOCAL_HOST_HEADER=
ARCHES_MAP_BASE_URL=
ARCHES_MAP_HOST_HEADER=
# Comma-separated public hosts allowed to access the Vite dev server.
VITE_ALLOWED_HOSTS=
# Optional target for the local layout API when Vite runs outside Docker.
LAYOUT_API_PROXY_TARGET=
